generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

model User {
  id            String   @id @default(cuid())
  loginId       String   @unique
  password      String
  name          String
  phone         String
  phoneEnc      String? // pgp encrypted
  interests     String[] @default([])
  role          String   @default("USER")
  otpSecret     String? // admin 2FA
  ci            String? // PASS CI (나중에)
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
  purchases     Purchase[]
  pdfLogs       PdfLog[]
  subscriptions Subscription?
  wrongNotes    WrongNote[]
  mockResults   MockResult[]
}

model Flipbook {
  id         String @id @default(cuid())
  title      String
  certType   String
  certDetail String?
  type       String // GICHUL, YESANG, RESTORE
  price      Int
  totalPages Int
  coverUrl   String
  pdfUrl     String?
  accuracy   Float?
  year       Int?
  round      Int?
  isPublished Boolean @default(true)
  createdAt  DateTime @default(now())
  pages      FlipbookPage[]
  purchases  Purchase[]
}

model FlipbookPage {
  id         String @id @default(cuid())
  flipbookId String
  pageNumber Int
  imageUrl   String // canvas rendered
  subject    String?
  subjectNo  Int?
  question   Json?
  solution   Json? // 풀이
  keyword    String?
  flipbook   Flipbook @relation(fields: [flipbookId], references: [id], onDelete: Cascade)
  @@unique([flipbookId, pageNumber])
}

model Purchase {
  id         String @id @default(cuid())
  userId     String
  flipbookId String
  amount     Int
  realPrice  Int // 서버 검증용
  pgTid      String?
  verified   Boolean @default(false)
  createdAt  DateTime @default(now())
  user       User @relation(fields: [userId], references: [id])
  flipbook   Flipbook @relation(fields: [flipbookId], references: [id])
  @@unique([userId, flipbookId])
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String   @unique
  plan      String // BASIC_10Y, EXPECTED_300, YEAR_PASS, ONEPASS_1, UPDATE_2
  status    String   @default("ACTIVE")
  startAt   DateTime @default(now())
  endAt     DateTime
  pdfQuota  Int      @default(5)
  pdfUsed   Int      @default(0)
  user      User     @relation(fields: [userId], references: [id])
}

model PdfLog {
  id         String @id @default(cuid())
  userId     String
  flipbookId String
  ip         String?
  ua         String?
  createdAt  DateTime @default(now())
  user       User @relation(fields: [userId], references: [id])
}

model WrongNote {
  id           String   @id @default(cuid())
  userId       String
  flipbookId   String
  pageId       String
  question     Json
  nextReviewAt DateTime // 3/7/15일 후
  reviewCount  Int      @default(0)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
}

model MockResult {
  id         String   @id @default(cuid())
  userId     String
  flipbookId String
  totalQ     Int
  correctQ   Int
  score      Float
  subjectScores Json // {"전기자기학": 80, ...}
  timeUsed   Int // 초
  passed     Boolean
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model Analysis {
  id       String @id @default(cuid())
  certType String
  year     Int
  round    Int?
  subject  String
  keyword  String
  count    Int
}

model Coupon {
  id         String   @id @default(cuid())
  userId     String
  code       String   @unique
  discount   Int
  validUntil DateTime
  used       Boolean  @default(false)
}

model Job {
  id           String @id @default(cuid())
  type         String // GUIN, GUJIK
  company      String?
  title        String
  certRequired String[] @default([])
  location     String
  salary       String?
  contact      String
  verified     Boolean @default(false)
  createdAt    DateTime @default(now())
}
