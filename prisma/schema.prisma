generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 코드가 사용하는 필드와 맞춘 스키마입니다. (추가 중심 변경 — 기존 컬럼은 유지)
// 적용: npx prisma db push  (운영 DB는 백업 후 실행)

model User {
  id                   String    @id @default(cuid())
  loginId              String    @unique
  password             String
  name                 String
  email                String?   @unique
  phone                String?
  interests            String[]  @default([])
  role                 String    @default("USER")
  points               Int       @default(0)
  pointsUpdatedAt      DateTime?
  referredBy           String?   // 추천인 loginId
  referralCode         String?   @unique
  referralRewarded     Boolean   @default(false) // 추천인 포인트 지급 완료 여부
  plan                 String    @default("FREE")
  subscription         String?
  subscriptionExpiresAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  purchases            Purchase[]
  wrongNotes           WrongNote[]
  bookmarks            Bookmark[]
}

model Purchase {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  flipbookId String?
  amount     Int      @default(0)
  pgTid      String?  // 결제 식별 키 (중복 처리 방지)
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Job {
  id           String   @id @default(cuid())
  type         String   // 구인 | 구직
  title        String
  company      String
  location     String   @default("서울")
  salary       String   @default("협의")
  cert         String   @default("전기기사")
  description  String   @default("")
  contact      String   @default("")
  files        Json?
  userId       String
  userLoginId  String?
  paid         Boolean  @default(false)
  paidAmount   Int      @default(0)
  hireConfirmed Boolean @default(false)
  createdAt    DateTime @default(now())
  @@index([type])
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  createdAt  DateTime @default(now())
  @@unique([userId, questionId])
  @@index([userId])
}

model Question {
  id          String   @id @default(cuid())
  question    String
  content     String?
  choices     Json?
  options     Json?
  answer      Json?
  explanation String?
  subject     String?
  category    String?
  year        String?
  difficulty  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Flipbook {
  id          String   @id @default(cuid())
  authorId    String?  // 교재 저자 (Author.id), 기출 등은 비어 있음
  title       String
  category    String?
  certType    String?
  year        Int?
  round       Int?
  type        String?
  price       Int      @default(0)
  totalPages  Int      @default(0)
  coverUrl    String?
  pdfUrl      String?
  fileName    String?
  fileSize    Int?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  pages       FlipbookPage[]
}

model FlipbookPage {
  id         String   @id @default(cuid())
  flipbookId String
  flipbook   Flipbook @relation(fields: [flipbookId], references: [id], onDelete: Cascade)
  pageNumber Int
  subject    String?
  question   String?
  options    Json?
  answer     String?
  keyword    String?
  createdAt  DateTime @default(now())
}

model WrongNote {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId   String?
  questionTitle String?
  category     String?
  certType     String?
  flipbookId   String?
  pageId       String?
  question     Json?
  count        Int       @default(1)
  nextReviewAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@index([userId])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model ProblemType {
  id        String   @id @default(cuid())
  name      String
  category  String
  count     Int      @default(0)
  createdAt DateTime @default(now())
}

model ProblemFolder {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  adminId   String
  targetId  String
  details   String?
  ip        String?
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model Payment {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

model ExamRound {
  id          String   @id @default(cuid())
  category    String
  round       String
  durationMin Int      @default(150)
  passScore   Int      @default(60)
  subjectMin  Int      @default(0)
  createdAt   DateTime @default(now())
  @@unique([category, round])
}

model ExamQuestion {
  id          String   @id @default(cuid())
  category    String
  round       String
  subject     String
  number      Int
  content     String
  choices     Json
  answer      Int
  explanation String?
  kind        String   @default("기출")
  createdAt   DateTime @default(now())
  @@unique([category, round, number])
}

model ExamAttempt {
  id          String    @id @default(cuid())
  userId      String
  category    String
  round       String
  startedAt   DateTime  @default(now())
  deadlineAt  DateTime
  submittedAt DateTime?
  answers     Json?
  result      Json?
  total       Int?
  passed      Boolean?
  timedOut    Boolean   @default(false)
  @@index([userId])
}

model Inquiry {
  id          String   @id @default(cuid())
  userId      String
  userLoginId String?
  category    String   // 버그 | 건의 | 오답 | 기타
  title       String
  body        String
  refId       String?  // 오답 문의일 때 문항 id
  refInfo     String?  // 예: 전기기사 2022년 04월 24일 3번
  status      String   @default("접수") // 접수 | 확인 | 처리완료
  adminReply  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([userId])
  @@index([status])
}

model Author {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  isBusiness  Boolean  @default(false)
  bankInfo    Json?    // 정산 계좌 등 (관리자만 열람)
  status      String   @default("신청") // 신청 | 승인 | 중지
  createdAt   DateTime @default(now())
  @@index([status])
}

// 교재 구매 기록 (정산 기준). 결제 연동 후 생성됩니다.
model BookPurchase {
  id          String   @id @default(cuid())
  userId      String
  flipbookId  String
  amount      Int
  status      String   @default("완료") // 완료 | 환불
  settledMonth String? // 정산 완료된 달 (YYYY-MM)
  createdAt   DateTime @default(now())
  @@index([flipbookId])
  @@index([userId])
}
