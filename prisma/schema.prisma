
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  loginId   String   @unique
  password  String
  name      String
  phone     String
  interests String[]
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  purchases Purchase[]
}

model Purchase {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  flipbookId String?
  amount    Int      @default(0)
  pgTid     String?
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Question {
  id          String   @id @default(cuid())
  question    String
  content     String?
  choices     Json?
  options     Json?
  answer      Json?
  explanation String?
  subject     String?
  category    String?
  year        String?
  difficulty  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Flipbook {
  id         String   @id @default(cuid())
  title      String
  certType   String?
  year       Int?
  round      Int?
  type       String?
  price      Int      @default(0)
  totalPages Int      @default(0)
  coverUrl   String?
  isPublished Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  pages      FlipbookPage[]
}

model FlipbookPage {
  id         String   @id @default(cuid())
  flipbookId String
  flipbook   Flipbook @relation(fields: [flipbookId], references: [id], onDelete: Cascade)
  pageNumber Int
  subject    String?
  question   String?
  options    Json?
  answer     String?
  keyword    String?
  createdAt  DateTime @default(now())
}

model WrongNote {
  id         String   @id @default(cuid())
  userId     String
  questionId String?
  certType   String?
  createdAt  DateTime @default(now())
}

model Payment {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}
